    {
      "name": "top_products",
      "displayName": "Top 10 Products by Net Revenue",
      "queryLines": [
        "SELECT\n",
        "  p.product_name AS product_name,\n",
        "  SUM(f.net_amount) AS net_item_revenue\n",
        "FROM\n",
        "  fk_ce_2026_07_1382.gold.fact_order_line f\n",
        "    JOIN fk_ce_2026_07_1382.gold.dim_product p\n",
        "      ON f.product_id = p.product_id\n",
        "    JOIN fk_ce_2026_07_1382.gold.dim_store s\n",
        "      ON f.store_id = s.store_id\n",
        "    JOIN fk_ce_2026_07_1382.gold.dim_date d\n",
        "      ON f.order_date_key = d.date_key\n",
        "WHERE\n",
        "  f.order_status = 'DELIVERED'\n",
        "  AND (\n",
        "    :city IS NULL\n",
        "    OR size(:city) = 0\n",
        "    OR array_contains(:city, s.city)\n",
        "  )\n",
        "  AND (\n",
        "    :order_date_range.min IS NULL\n",
        "    OR d.calendar_date >= :order_date_range.min\n",
        "  )\n",
        "  AND (\n",
        "    :order_date_range.max IS NULL\n",
        "    OR d.calendar_date <= :order_date_range.max\n",
        "  )\n",
        "GROUP BY\n",
        "  p.product_name\n",
        "ORDER BY\n",
        "  net_item_revenue DESC\n",
        "LIMIT 10"
      ],
      "parameters": [
        {
          "displayName": "City",
          "keyword": "city",
          "dataType": "STRING",
          "complexType": "MULTI",
          "defaultSelection": {}
        },
        {
          "displayName": "Order Date Range",
          "keyword": "order_date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {}
        }
      ]
    },
    {
      "name": "ops_metrics",
      "displayName": "FreshKart Operations Metrics",
      "config": {
        "source": "fk_ce_2026_07_1382.gold.agg_daily_store_sales",
        "measures": [
          {
            "name": "net_item_revenue",
            "expr": "SUM(net_items_revenue)",
            "displayName": "Net Item Revenue"
          },
          {
            "name": "delivered_orders",
            "expr": "SUM(delivered_orders)",
            "displayName": "Delivered Orders"
          },
          {
            "name": "on_time_orders",
            "expr": "SUM(on_time_orders)",
            "displayName": "On-Time Orders"
          },
          {
            "name": "avg_order_value",
            "expr": "SUM(net_items_revenue) / NULLIF(SUM(delivered_orders), 0)",
            "displayName": "Average Order Value"
          },
          {
            "name": "on_time_rate_pct",
            "expr": "SUM(on_time_orders) / NULLIF(SUM(delivered_orders), 0)",
            "displayName": "On-Time Rate %"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "expr": "source.* EXCEPT (delivered_orders, on_time_orders, on_time_rate_pct, net_items_revenue, gross_amount, discount_amount, delivery_fee_revenue, units_sold, cancelled_orders)"
          },
          {
            "name": "store_name",
            "expr": "store.store_name",
            "displayName": "Store Name"
          }
        ],
        "joins": [
          {
            "name": "store",
            "source": "fk_ce_2026_07_1382.gold.dim_store",
            "on": "source.store_id = store.store_id"
          }
        ]
      }
    }
  ],
